{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/environment_manifest.schema.json",
  "title": "EnvironmentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "collision", "kitRefs", "regionRefs"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "playerRadius", "maxSlideIterations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "playerRadius": { "type": "number", "exclusiveMinimum": 0 },
        "maxSlideIterations": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "kitRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "regionRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
