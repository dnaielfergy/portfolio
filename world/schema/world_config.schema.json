{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/world_config.schema.json",
  "title": "WorldConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "assets",
    "style",
    "intro",
    "cameraPresets",
    "ui",
    "vehicles",
    "environment",
    "nodes",
    "edges",
    "progression"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldId", "version", "title", "resumePdfUrl"],
      "properties": {
        "worldId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "resumePdfUrl": { "type": "string", "minLength": 1 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapImage", "referenceImages"],
      "properties": {
        "mapImage": { "type": "string", "minLength": 1 },
        "referenceImages": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "models": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "textures": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "pathStyle", "nodeMarkerStyle", "fogStyle", "regionPalettes"],
      "properties": {
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finish", "roundEdges", "noPhotorealism", "noHighFreqTextures"],
          "properties": {
            "finish": { "const": "matte" },
            "roundEdges": { "type": "boolean" },
            "noPhotorealism": { "type": "boolean" },
            "noHighFreqTextures": { "type": "boolean" }
          }
        },
        "pathStyle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseColor", "highlightColor", "thickness", "elevation", "pulseOnIntro", "traceDurationMs"],
          "properties": {
            "baseColor": { "$ref": "#/$defs/hexColor" },
            "highlightColor": { "$ref": "#/$defs/hexColor" },
            "loadedColor": { "$ref": "#/$defs/hexColor" },
            "completedColor": { "$ref": "#/$defs/hexColor" },
            "nextColor": { "$ref": "#/$defs/hexColor" },
            "thickness": { "type": "number", "exclusiveMinimum": 0 },
            "elevation": { "type": "number", "minimum": 0 },
            "pulseOnIntro": { "type": "boolean" },
            "traceDurationMs": { "type": "integer", "minimum": 1 },
            "introSweepMs": { "type": "integer", "minimum": 1 },
            "stateFadeMs": { "type": "integer", "minimum": 0 }
          }
        },
        "nodeMarkerStyle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "defaultScale", "completedColor", "hoverGlow", "labelOnProximity"],
          "properties": {
            "shape": { "const": "disc" },
            "defaultScale": { "type": "number", "exclusiveMinimum": 0 },
            "completedColor": { "$ref": "#/$defs/hexColor" },
            "hoverGlow": { "type": "boolean" },
            "labelOnProximity": { "type": "boolean" }
          }
        },
        "fogStyle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introFogOpacity", "settleFogOpacity", "sfFogOpacity"],
          "properties": {
            "introFogOpacity": { "$ref": "#/$defs/opacity" },
            "settleFogOpacity": { "$ref": "#/$defs/opacity" },
            "sfFogOpacity": { "$ref": "#/$defs/opacity" }
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worldVisualMultiplier", "vehicleVisualMultiplier"],
          "properties": {
            "worldVisualMultiplier": { "type": "number", "exclusiveMinimum": 0 },
            "vehicleVisualMultiplier": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "regionPalettes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primary", "secondary", "accent"],
            "properties": {
              "primary": { "$ref": "#/$defs/hexColor" },
              "secondary": { "$ref": "#/$defs/hexColor" },
              "accent": { "$ref": "#/$defs/hexColor" }
            }
          }
        }
      }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "durationMs", "startPreset", "endPreset", "skipOnInput", "settleToState", "pathTrace", "fogAnimation"],
      "properties": {
        "enabled": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "startPreset": { "type": "string", "minLength": 1 },
        "endPreset": { "type": "string", "minLength": 1 },
        "skipOnInput": { "type": "boolean" },
        "settleToState": { "const": "idleMap" },
        "pathTrace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "startNodeId", "endNodeId", "durationMs", "glowColor", "pulseNodes"],
          "properties": {
            "enabled": { "type": "boolean" },
            "startNodeId": { "type": "string", "minLength": 1 },
            "endNodeId": { "type": "string", "minLength": 1 },
            "durationMs": { "type": "integer", "minimum": 1 },
            "glowColor": { "$ref": "#/$defs/hexColor" },
            "pulseNodes": { "type": "boolean" }
          }
        },
        "fogAnimation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startOpacity", "endOpacity", "easing"],
          "properties": {
            "startOpacity": { "$ref": "#/$defs/opacity" },
            "endOpacity": { "$ref": "#/$defs/opacity" },
            "easing": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cameraPresets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introStart", "introEnd", "focusCharlotte", "checkpointDefault", "finalSF"],
      "properties": {
        "introStart": { "$ref": "#/$defs/cameraPreset" },
        "introEnd": { "$ref": "#/$defs/cameraPreset" },
        "focusCharlotte": { "$ref": "#/$defs/cameraPreset" },
        "checkpointDefault": { "$ref": "#/$defs/cameraPreset" },
        "finalSF": { "$ref": "#/$defs/cameraPreset" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startButton", "tutorial", "hud", "checkpointPanel"],
      "properties": {
        "startButton": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "centered"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "centered": { "type": "boolean" }
          }
        },
        "tutorial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "lines", "dismissOnAnyInput"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "dismissOnAnyInput": { "type": "boolean" }
          }
        },
        "hud": {
          "type": "object",
          "additionalProperties": false,
          "required": ["showProgress", "showResumeLink", "resumeLabel"],
          "properties": {
            "showProgress": { "type": "boolean" },
            "showResumeLink": { "type": "boolean" },
            "resumeLabel": { "type": "string", "minLength": 1 }
          }
        },
        "checkpointPanel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["titleSuffix", "openKey", "closeKey", "slideFrom", "widthPercent", "blurBackground"],
          "properties": {
            "titleSuffix": { "type": "string", "minLength": 1 },
            "openKey": { "const": "Enter" },
            "closeKey": { "const": "Escape" },
            "slideFrom": { "const": "right" },
            "widthPercent": { "type": "number", "minimum": 40, "maximum": 70 },
            "blurBackground": { "type": "boolean" }
          }
        }
      }
    },
    "vehicles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "transformRules", "stageByNodeId"],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "ref"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "collider": {
                "type": "object",
                "additionalProperties": false,
                "required": ["shape", "radius"],
                "properties": {
                  "shape": { "const": "circle" },
                  "radius": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        "transformRules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs", "spinDegrees", "swapAtPercent", "motionBlur", "dustPuff", "cameraMicroZoomPercent"],
          "properties": {
            "durationMs": { "type": "integer", "minimum": 1 },
            "spinDegrees": { "const": 360 },
            "swapAtPercent": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "motionBlur": { "type": "boolean" },
            "dustPuff": { "type": "boolean" },
            "cameraMicroZoomPercent": { "type": "number", "minimum": 0 }
          }
        },
        "stageByNodeId": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestRef": { "type": "string", "minLength": 1 },
        "buildings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/environmentBuildingObject" }
        },
        "props": {
          "type": "array",
          "items": { "$ref": "#/$defs/environmentObject" }
        },
        "collision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "playerRadius", "maxSlideIterations"],
          "properties": {
            "enabled": { "type": "boolean" },
            "playerRadius": { "type": "number", "exclusiveMinimum": 0 },
            "maxSlideIterations": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        }
      },
      "anyOf": [
        { "required": ["manifestRef"] },
        { "required": ["buildings", "collision"] }
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "region", "coords", "radius", "marker", "checkpointContentRef", "unlock", "completion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["main", "side", "final"] },
          "region": { "type": "string", "minLength": 1 },
          "coords": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "mapAnchorPx": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "marker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "icon"],
            "properties": {
              "label": { "type": "boolean" },
              "icon": { "type": "string", "minLength": 1 }
            }
          },
          "checkpointContentRef": {
            "type": "string",
            "pattern": "^/content/checkpoints/.+\\.md$"
          },
          "unlock": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "start" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "nodeId"],
                "properties": {
                  "type": { "enum": ["after_complete", "after_available"] },
                  "nodeId": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "completion": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "open_checkpoint_once" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "enter_node" }
                }
              }
            ]
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type", "visibleWhen"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": { "enum": ["main", "side"] },
          "visibleWhen": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "always" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "nodeId"],
                "properties": {
                  "type": { "enum": ["after_available", "after_complete"] },
                  "nodeId": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "styleKey": { "type": "string", "minLength": 1 },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          },
          "renderWaypointsPx": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startNodeId", "finalNodeId", "mainSequence", "sideQuests", "onCompleteNode", "onEnterFinal"],
      "properties": {
        "startNodeId": { "type": "string", "minLength": 1 },
        "finalNodeId": { "type": "string", "minLength": 1 },
        "mainSequence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sideQuests": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "onCompleteNode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setNodeCompletedColor", "enableNextEdgeGlow", "triggerTransform"],
          "properties": {
            "setNodeCompletedColor": { "$ref": "#/$defs/hexColor" },
            "enableNextEdgeGlow": { "type": "boolean" },
            "triggerTransform": { "type": "boolean" }
          }
        },
        "onEnterFinal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lockMovement", "increaseFog", "showResumeCTA", "showFutureLevelsText"],
          "properties": {
            "lockMovement": { "type": "boolean" },
            "increaseFog": { "type": "boolean" },
            "showResumeCTA": { "type": "boolean" },
            "showFutureLevelsText": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cameraPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "lookAt", "fov", "damping"],
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "lookAt": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "fov": { "type": "number", "exclusiveMinimum": 0 },
        "damping": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "environmentObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "size"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "elevation": { "type": "number", "minimum": 0 }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "rotation": { "type": "number" },
        "styleKey": { "type": "string", "minLength": 1 }
      }
    },
    "environmentBuildingObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "size"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "elevation": { "type": "number", "minimum": 0 }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "rotation": { "type": "number" },
        "styleKey": { "type": "string", "minLength": 1 },
        "collider": { "type": "boolean" }
      }
    }
  }
}
